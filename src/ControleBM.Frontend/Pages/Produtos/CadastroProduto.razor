@page "/produtos/cadastro"
@inject NavigationManager Navigation

<div class="form-container">
    <div class="form-header">
        <button class="btn-back" @onclick="Voltar">← Voltar</button>
        <h2>Novo Produto</h2>
    </div>

    <EditForm Model="@produto" OnValidSubmit="Salvar" class="form">
        <DataAnnotationsValidator />

        <div class="form-grid">
            <div class="form-group">
                <label>Nome do Produto</label>
                <InputText @bind-Value="produto.Nome" class="form-input" placeholder="Digite o nome" />
                <ValidationMessage For="@(() => produto.Nome)" />
            </div>

            <div class="form-group">
                <label>Categoria</label>
                <InputSelect @bind-Value="produto.Categoria" class="form-input">
                    <option value="">Selecione...</option>
                    <option value="Eletrônicos">Eletrônicos</option>
                    <option value="Roupas">Roupas</option>
                    <option value="Alimentos">Alimentos</option>
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Preço</label>
                <InputNumber @bind-Value="produto.Preco" class="form-input" placeholder="0,00" />
            </div>

            <div class="form-group">
                <label>Estoque Inicial</label>
                <InputNumber @bind-Value="produto.Estoque" class="form-input" placeholder="0" />
            </div>

            <div class="form-group full-width">
                <label>Descrição</label>
                <InputTextArea @bind-Value="produto.Descricao" class="form-input textarea" rows="4" placeholder="Descrição do produto..." />
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <InputCheckbox @bind-Value="produto.Ativo" />
                    <span>Produto ativo</span>
                </label>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-secondary" @onclick="Voltar">Cancelar</button>
            <button type="submit" class="btn btn-primary">Salvar Produto</button>
        </div>
    </EditForm>
</div>

@code {
    private ProdutoForm produto = new();

    private void Salvar()
    {
        // Chamar API para salvar
        Navigation.NavigateTo("/produtos");
    }

    private void Voltar() => Navigation.NavigateTo("/produtos");

    public class ProdutoForm
    {
        public string Nome { get; set; } = "";
        public string Categoria { get; set; } = "";
        public decimal Preco { get; set; }
        public int Estoque { get; set; }
        public string Descricao { get; set; } = "";
        public bool Ativo { get; set; } = true;
    }
}