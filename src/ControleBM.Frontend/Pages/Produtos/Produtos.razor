@page "/produtos"
@using ControleBM.Frontend.Services
@using ControleBM.Shared.DTOs
@using ControleBM.Shared.Enums
@inject IProdutoService ProdutoService
@inject NavigationManager Navigation

<div class="page-container">
    <div class="page-header">
        <h2>Produtos</h2>
        <button class="btn btn-primary" @onclick="NovoProduto">
            + Novo Produto
        </button>
    </div>

    <div class="filters-bar">
        <input type="text" class="input-search" placeholder="Buscar produto..." @bind="searchTerm" @bind:event="oninput" />
        <select class="input-select" @bind="filtroTipo">
            <Component />
        </select>
    </div>

    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Custo</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in produtos)
                {
                    <tr>
                        <td>@produto.Nome</td>
                        <td>@produto.Tipo</td>
                        <td>R$ @produto.CustoUnitario.ToString("N2")</td>
                        <td>R$ @produto.PrecoVenda.ToString("N2")</td>
                        <td>
                            <span class="stock @(produto.EstoqueAtual < 10 ? "low" : "")">
                                @produto.EstoqueAtual unid.
                            </span>
                        </td>
                        <td>
                            <div class="actions">
                                <button class="btn-icon" title="Editar" @onclick="() => Editar(produto.Id)">✏️</button>
                                <button class="btn-icon" title="Excluir" @onclick="() => Excluir(produto.Id)">🗑️</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<ProdutoResponseDto> produtos = new();
    private string searchTerm = "";
    private string filtroCategoria = "";
    private TipoProduto? filtroTipo = null;

    protected override async Task OnInitializedAsync()
    {
        produtos = await ProdutoService.GetProdutosAsync();
    }

    private IEnumerable<ProdutoResponseDto> ProdutosFiltrados =>
        produtos.Where(p =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             p.Nome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (!filtroTipo.HasValue || p.Tipo == filtroTipo)
        );

    private void NovoProduto()
        => Navigation.NavigateTo("/produtos/cadastro");

    private void Editar(Guid id)
        => Navigation.NavigateTo($"/produtos/editar/{id}");

    private async Task Excluir(Guid id)
    {
        await ProdutoService.DeleteProdutoAsync(id);
        produtos = await ProdutoService.GetProdutosAsync();
    }
}
