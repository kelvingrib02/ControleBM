@page "/produtos/editar/{id:guid}"
@using ControleBM.Shared.DTOs
@using ControleBM.Shared.Enums
@using ControleBM.Frontend.Services
@inject IProdutoService ProdutoService
@inject NavigationManager Navigation

<div class="form-container">
    <div class="form-header">
        <button class="btn-back" @onclick="Cancelar">← Voltar</button>
        <h1>Editar Produto</h1>
    </div>

    @if (produto == null)
    {
        <div class="vazio">Carregando...</div>
    }
    else
    {
        <EditForm Model="produto" OnValidSubmit="SalvarEdicao">
            <DataAnnotationsValidator />

            <div class="form-card">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label>Nome do produto</label>
                        <InputText @bind-Value="produto.Nome" class="form-input" />
                        <ValidationMessage For="@(() => produto.Nome)" />
                    </div>

                    <div class="form-group">
                        <label>Categoria</label>
                        <InputSelect @bind-Value="produto.Tipo" class="form-input">
                            @foreach (var tipo in Enum.GetValues<TipoProduto>())
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label>Estoque atual</label>
                        <InputNumber @bind-Value="produto.EstoqueAtual" class="form-input" />
                    </div>

                    <div class="form-group">
                        <label>Preço de venda</label>
                        <div class="input-prefixo">
                            <span class="prefixo">R$</span>
                            <InputNumber @bind-Value="produto.PrecoVenda" class="form-input" step="0.01" />
                        </div>
                        <ValidationMessage For="@(() => produto.PrecoVenda)" />
                    </div>

                    <div class="form-group">
                        <label>Custo (quanto você paga)</label>
                        <div class="input-prefixo">
                            <span class="prefixo">R$</span>
                            <InputNumber @bind-Value="produto.CustoUnitario" class="form-input" step="0.01" />
                        </div>
                    </div>

                    <div class="form-group full-width">
                        <label>Observação (opcional)</label>
                        <InputTextArea @bind-Value="produto.Descricao" class="form-input" rows="3" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(erro))
                {
                    <p class="validation-message">@erro</p>
                }

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@salvando">
                        @(salvando ? "Salvando..." : "Salvar alterações")
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProdutoRequestDto? produto;
    private bool salvando;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        var existente = await ProdutoService.GetProdutoByIdAsync(Id);

        if (existente != null)
        {
            produto = new ProdutoRequestDto
            {
                Nome = existente.Nome,
                Descricao = existente.Descricao,
                PrecoVenda = existente.PrecoVenda,
                CustoUnitario = existente.CustoUnitario,
                EstoqueAtual = existente.EstoqueAtual,
                Tipo = existente.Tipo
            };
        }
    }

    private async Task SalvarEdicao()
    {
        if (produto == null) return;

        salvando = true;
        erro = null;
        try
        {
            await ProdutoService.UpdateProdutoAsync(Id, produto);
            Navigation.NavigateTo("/produtos");
        }
        catch
        {
            erro = "Não foi possível salvar. Verifique a conexão e tente de novo.";
            salvando = false;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/produtos");
}
