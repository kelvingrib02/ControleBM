@page "/produtos/editar/{id:guid}"
@using ControleBM.Shared.DTOs
@using ControleBM.Shared.Enums
@using ControleBM.Frontend.Services
@inject IProdutoService ProdutoService
@inject NavigationManager Navigation

<h3>Editar Produto</h3>

@if (produto == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <EditForm Model="produto" OnValidSubmit="SalvarEdicao">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nome:</label>
            <InputText @bind-Value="produto.Nome" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descrição:</label>
            <InputTextArea @bind-Value="produto.Descricao" class="form-control" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Preço de Venda:</label>
                <div class="input-group">
                    <span class="input-group-text">R$</span>
                    <InputNumber @bind-Value="produto.PrecoVenda"
                                 class="form-control"
                                 step="0.01" />
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Custo Unitário:</label>
                <div class="input-group">
                    <span class="input-group-text">R$</span>
                    <InputNumber @bind-Value="produto.CustoUnitario"
                                 class="form-control"
                                 step="0.01" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Estoque Atual:</label>
                <InputNumber @bind-Value="produto.EstoqueAtual" class="form-control" />
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo:</label>
                <InputSelect @bind-Value="produto.Tipo" class="form-control">
                    @foreach (var tipo in Enum.GetValues<TipoProduto>())
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">💾 Salvar</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancelar">❌ Cancelar</button>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ProdutoRequestDto? produto;

    protected override async Task OnInitializedAsync()
    {
        var produtoExistente = await ProdutoService.GetProdutoByIdAsync(Id);

        if (produtoExistente != null)
        {
            produto = new ProdutoRequestDto
            {
                Nome = produtoExistente.Nome,
                Descricao = produtoExistente.Descricao,
                PrecoVenda = produtoExistente.PrecoVenda,
                CustoUnitario = produtoExistente.CustoUnitario,
                EstoqueAtual = produtoExistente.EstoqueAtual,
                Tipo = produtoExistente.Tipo
            };
        }
    }

    private async Task SalvarEdicao()
    {
        if (produto != null)
        {
            await ProdutoService.UpdateProdutoAsync(Id, produto);
            Navigation.NavigateTo("/produtos");
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/produtos");
    }
}