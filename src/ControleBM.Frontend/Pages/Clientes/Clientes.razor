@page "/clientes"
@using ControleBM.Frontend.Services
@using ControleBM.Shared.DTOs
@inject IClienteService ClienteService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="page-header">
    <div>
        <h1>Clientes</h1>
        <p class="page-subtitle">@clientes.Count cadastrados</p>
    </div>
    <button class="btn btn-primary btn-lg" @onclick="NovoCliente">+ Novo Cliente</button>
</div>

<div class="filters-bar">
    <input type="text" class="input-search" placeholder="Buscar cliente pelo nome..."
           @bind="searchTerm" @bind:event="oninput" />
    <select class="input-select" @bind="soDevedores">
        <option value="false">Todos os clientes</option>
        <option value="true">Só quem está devendo</option>
    </select>
</div>

@if (semConexao)
{
    <div class="table-container">
        <div class="vazio">Não foi possível conectar ao servidor.<br />Verifique se o sistema está ligado e tente de novo.</div>
    </div>
}
else
{
<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Telefone</th>
                <th>Situação</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!ClientesFiltrados.Any())
            {
                <tr>
                    <td colspan="4"><div class="vazio">Nenhum cliente encontrado.</div></td>
                </tr>
            }
            else
            {
                @foreach (var cliente in ClientesFiltrados)
                {
                    <tr>
                        <td class="celula-forte">@cliente.Nome</td>
                        <td>@(string.IsNullOrWhiteSpace(cliente.Telefone) ? "—" : cliente.Telefone)</td>
                        <td>
                            @if (cliente.SaldoDevedor > 0)
                            {
                                <span class="valor-deve">Deve @cliente.SaldoDevedor.ToString("C")</span>
                            }
                            else
                            {
                                <span class="pill pill-ok">Em dia</span>
                            }
                        </td>
                        <td>
                            <div class="col-acoes">
                                <button class="btn-acao editar" @onclick="() => Editar(cliente.Id)">✏️ Editar</button>
                                <button class="btn-acao excluir" @onclick="() => Excluir(cliente)">🗑️ Excluir</button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
}

@code {
    private List<ClienteResponseDto> clientes = new();
    private string searchTerm = "";
    private bool soDevedores = false;
    private bool semConexao;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clientes = await ClienteService.GetClienteAsync();
        }
        catch
        {
            semConexao = true;
        }
    }

    private IEnumerable<ClienteResponseDto> ClientesFiltrados =>
        clientes.Where(c =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             c.Nome.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) &&
            (!soDevedores || c.SaldoDevedor > 0));

    private void NovoCliente() => Navigation.NavigateTo("/clientes/cadastro");

    private void Editar(Guid id) => Navigation.NavigateTo($"/clientes/editar/{id}");

    private async Task Excluir(ClienteResponseDto cliente)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Excluir o cliente \"{cliente.Nome}\"?");
        if (!ok) return;

        await ClienteService.DeleteClienteAsync(cliente.Id);
        clientes = await ClienteService.GetClienteAsync();
    }
}
