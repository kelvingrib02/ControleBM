@page "/clientes/editar/{id:guid}"
@using ControleBM.Shared.DTOs
@using ControleBM.Frontend.Services
@inject IClienteService ClienteService
@inject NavigationManager Navigation

<div class="form-container">
    <div class="form-header">
        <button class="btn-back" @onclick="Cancelar">← Voltar</button>
        <h1>Editar Cliente</h1>
    </div>

    @if (cliente == null)
    {
        <div class="vazio">Carregando...</div>
    }
    else
    {
        <EditForm Model="cliente" OnValidSubmit="SalvarEdicao">
            <DataAnnotationsValidator />

            <div class="form-card">
                <div class="form-grid">
                    <div class="form-group full-width">
                        <label>Nome do cliente</label>
                        <InputText @bind-Value="cliente.Nome" class="form-input" />
                        <ValidationMessage For="@(() => cliente.Nome)" />
                    </div>

                    <div class="form-group">
                        <label>Telefone (opcional)</label>
                        <InputText @bind-Value="cliente.Telefone" class="form-input" placeholder="(00) 00000-0000" />
                    </div>

                    <div class="form-group">
                        <label>Saldo devedor (fiado)</label>
                        <div class="input-prefixo">
                            <span class="prefixo">R$</span>
                            <InputNumber @bind-Value="cliente.SaldoDevedor" class="form-input" step="0.01" />
                        </div>
                        <span class="dica">Atualize quando o cliente pagar ou pendurar mais.</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(erro))
                {
                    <p class="validation-message">@erro</p>
                }

                <div class="form-actions">
                    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Cancelar</button>
                    <button type="submit" class="btn btn-primary" disabled="@salvando">
                        @(salvando ? "Salvando..." : "Salvar alterações")
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private ClienteRequestDto? cliente;
    private bool salvando;
    private string? erro;

    protected override async Task OnInitializedAsync()
    {
        var existente = await ClienteService.GetClienteByIdAsync(Id);

        if (existente != null)
        {
            cliente = new ClienteRequestDto
            {
                Nome = existente.Nome,
                Telefone = existente.Telefone,
                SaldoDevedor = existente.SaldoDevedor,
                Ativo = existente.Ativo
            };
        }
    }

    private async Task SalvarEdicao()
    {
        if (cliente == null) return;

        salvando = true;
        erro = null;
        try
        {
            await ClienteService.UpdateClienteAsync(Id, cliente);
            Navigation.NavigateTo("/clientes");
        }
        catch
        {
            erro = "Não foi possível salvar. Verifique a conexão e tente de novo.";
            salvando = false;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/clientes");
}
