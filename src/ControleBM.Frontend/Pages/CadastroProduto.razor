@page "/produtos/cadastro"
@using ControleBM.Shared.DTOs
@using ControleBM.Shared.Enums
@using ControleBM.Frontend.Services
@inject IProdutoService ProdutoService
@inject NavigationManager Navigation

<PageTitle>Novo Produto</PageTitle>

<div class="container">
    <h3>Cadastro de Produto</h3>
    <hr />

    <EditForm Model="produto" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="nome" class="form-label">Nome do Produto</label>
            <InputText id="nome" class="form-control" @bind-Value="produto.Nome" />
            <ValidationMessage For="@(() => produto.Nome)" />
        </div>

        <div class="mb-3">
            <label for="descricao" class="form-label">Descrição</label>
            <InputTextArea id="descricao" class="form-control" @bind-Value="produto.Descricao" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="tipo" class="form-label">Tipo</label>
                <InputSelect id="tipo" class="form-control" @bind-Value="produto.Tipo">
                    @foreach (var tipo in Enum.GetValues(typeof(TipoProduto)))
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </InputSelect>
            </div>

            <div class="col-md-6 mb-3">
                <label for="estoque" class="form-label">Estoque Inicial</label>
                <InputNumber id="estoque" class="form-control" @bind-Value="produto.EstoqueAtual" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="custo" class="form-label">Preço de Custo (R$)</label>
                <InputNumber id="custo" class="form-control" @bind-Value="produto.CustoUnitario" />
            </div>

            <div class="col-md-6 mb-3">
                <label for="venda" class="form-label">Preço de Venda (R$)</label>
                <InputNumber id="venda" class="form-control" @bind-Value="produto.PrecoVenda" />
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">💾 Salvar Produto</button>
            <a href="/produtos" class="btn btn-secondary ms-2">Voltar</a>
        </div>
    </EditForm>
</div>

@code {
    private ProdutoRequestDto produto = new();

    private async Task HandleValidSubmit()
    {
        try
        {
            await ProdutoService.CreateProdutoAsync(produto);
            Navigation.NavigateTo("/produtos");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar: {ex.Message}");
        }
    }
}