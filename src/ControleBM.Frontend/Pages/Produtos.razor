@page "/produtos"
@using ControleBM.Shared.DTOs
@using ControleBM.Shared.Enums
@using ControleBM.Frontend.Services
@inject IProdutoService ProdutoService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3>Lista de Produtos</h3>

<div class="mb-3">
    <button class="btn btn-success" @onclick="NovoProduto">➕ Novo Produto</button>
</div>

@if (produtos == null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Preço Venda</th>
                <th>Custo</th>
                <th>Lucro Unit.</th>
                <th>Estoque</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var produto in produtos)
            {
                <tr>
                    <td>@produto.Nome</td>
                    <td>@produto.Tipo</td>
                    <td>R$ @produto.PrecoVenda.ToString("N2")</td>
                    <td>R$ @produto.CustoUnitario.ToString("N2")</td>
                    <td>R$ @((produto.PrecoVenda - produto.CustoUnitario).ToString("N2"))</td>
                    <td>
                        <span class="badge @GetEstoqueBadge(produto.EstoqueAtual)">
                            @produto.EstoqueAtual
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => Editar(produto.Id)">
                            ✏️ Editar
                        </button>
                        <button class="btn btn-sm btn-danger" @onclick="() => Excluir(produto.Id)">
                            🗑️ Excluir
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProdutoResponseDto>? produtos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        produtos = await ProdutoService.GetProdutosAsync();
    }

    private void NovoProduto()
    {
        Navigation.NavigateTo("/produtos/novo");
    }

    private void Editar(Guid id)
    {
        Navigation.NavigateTo($"/produtos/editar/{id}");
    }

    private async Task Excluir(Guid id)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", "Deseja realmente excluir este produto?"))
        {
            await ProdutoService.DeleteProdutoAsync(id);
            await CarregarProdutos();
        }
    }

    private string GetEstoqueBadge(int estoque)
    {
        return estoque switch
        {
            <= 5 => "bg-danger",
            <= 20 => "bg-warning",
            _ => "bg-success"
        };
    }
}