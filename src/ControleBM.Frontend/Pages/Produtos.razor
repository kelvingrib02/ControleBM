@page "/produtos"
@using ControleBM.Shared.DTOs
@using ControleBM.Frontend.Services
@inject IProdutoService ProdutoService
@inject NavigationManager Navigation

<PageTitle>Estoque do Bar</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Estoque de Produtos</h1>
    <button class="btn btn-primary" @onclick="IrParaCadastro">
        Novo Produto
    </button>
</div>

<p>Gerencie aqui o estoque do bar.</p>

@if (produtos == null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Carregando...</span>
        </div>
    </div>
}
else if (!produtos.Any())
{
    <div class="alert alert-info">
        Nenhum produto cadastrado ainda. Clique em "Novo Produto" para começar!
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Custo</th>
                <th>Venda</th>
                <th>Estoque</th>
                <th>Lucro</th>
                <th class="text-center">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in produtos)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Tipo</td>
                    <td>@item.CustoUnitario.ToString("C2")</td>
                    <td>@item.PrecoVenda.ToString("C2")</td>
                    <td>
                        @if (item.EstoqueAtual < 5)
                        {
                            <span class="badge bg-danger">@item.EstoqueAtual (Baixo)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@item.EstoqueAtual</span>
                        }
                    </td>
                    <td class="text-success fw-bold">
                        @((item.PrecoVenda - item.CustoUnitario).ToString("C2"))
                    </td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-outline-warning me-1" title="Editar">
                            ✏️
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="Excluir">
                            🗑️
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProdutoResponseDto>? produtos;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        try
        {
            produtos = await ProdutoService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar produtos: {ex.Message}");
        }
    }

    private void IrParaCadastro()
    {
        Navigation.NavigateTo("/produtos/cadastro");
    }
}