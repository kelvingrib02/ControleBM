@page "/produtos"
@using ControleBM.Shared.DTOs
@using ControleBM.Frontend.Services
@inject IProdutoService ProdutoService

<PageTitle>Estoque do Bar</PageTitle>

<h1>📦 Estoque de Produtos</h1>

<p>Gerencie aqui o estoque do bar.</p>

@if (produtos == null)
{
    <p><em>Carregando estoque...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Custo (R$)</th>
                <th>Venda (R$)</th>
                <th>Estoque</th>
                <th>Lucro Unit.</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in produtos)
            {
                <tr>
                    <td>@item.Nome</td>
                    <td>@item.Tipo</td>
                    <td>@item.PrecoCusto.ToString("N2")</td>
                    <td>@item.PrecoVenda.ToString("N2")</td>
                    <td>
                        @if (item.QuantidadeEstoque < 5)
                        {
                            <span class="badge bg-danger">@item.QuantidadeEstoque (Baixo)</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@item.QuantidadeEstoque</span>
                        }
                    </td>
                    <td class="text-success fw-bold">
                        @((item.PrecoVenda - item.PrecoCusto).ToString("N2"))
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProdutoResponseDto>? produtos;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            produtos = await ProdutoService.GetProdutosAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar produtos: {ex.Message}");
        }
    }
}