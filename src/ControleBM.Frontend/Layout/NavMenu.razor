@inject NavigationManager NavManager

<div class="sidebar">

    <div class="sidebar-logo">
        <span class="marca">Bar do Marcio</span>
        <span class="sub">Controle</span>
    </div>

    <nav class="sidebar-nav">
        <NavLink class="menu-item" href="" Match="NavLinkMatch.All" @onclick="OnLinkClick">
            <span class="menu-icon">🏠</span>
            <span>Início</span>
        </NavLink>

        <NavLink class="menu-item" href="produtos" @onclick="OnLinkClick">
            <span class="menu-icon">📦</span>
            <span>Produtos</span>
        </NavLink>

        <NavLink class="menu-item" href="clientes" @onclick="OnLinkClick">
            <span class="menu-icon">👥</span>
            <span>Clientes</span>
        </NavLink>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-badge">BM</div>
        <div>
            <div class="nome">Bar do Marcio</div>
            <div class="papel">Sistema de controle</div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnLinkClick { get; set; }
}
