@inherits LayoutComponentBase

<div class="page-layout">

    <div class="sidebar-wrapper @(menuAberto ? "aberto" : "")">
        <NavMenu OnLinkClick="FecharMenu" />
    </div>
    <div class="sidebar-backdrop @(menuAberto ? "aberto" : "")" @onclick="FecharMenu"></div>

    <main class="content-wrapper">
        <div class="mobile-header">
            <span class="mobile-title">Bar do Marcio</span>
            <button class="mobile-menu-btn" @onclick="AlternarMenu" aria-label="Abrir menu">☰</button>
        </div>

        <div class="content-body fade-in">
            @Body
        </div>
    </main>
</div>

@code {
    private bool menuAberto;

    private void AlternarMenu() => menuAberto = !menuAberto;
    private void FecharMenu() => menuAberto = false;
}
